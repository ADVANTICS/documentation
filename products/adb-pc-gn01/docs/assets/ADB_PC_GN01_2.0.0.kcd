<?xml version='1.0' encoding='utf-8'?>
<NetworkDefinition xmlns="http://kayak.2codeornot2code.org/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="KCD_Definition.xsd">
  <Document name="ADB_PC_GN01" version="2.0.0" author="Thomas A" company="Advantics" date="2026-04-10" />
  <Node id="0" name="User" />
  <Node id="1" name="ADB_PC_GN01" />
  <Bus name="ADB_PC_GN01" baudrate="500000">

    <Message id="0x850040" length="1" name="GN01_Mode_Set" format="extended">
      <Notes>Configure GN01 operating mode</Notes>
      <Producer>
        <NodeRef id="0" />
      </Producer>
      <Signal name="mode" offset="0" length="8">
        <Notes>Requested operating mode

            DC_Controlled (0): DC side voltage controlled to setpoint, requires AC side input present
            AC_Controlled (1): AC side voltage controlled, will generate AC if not present
            Bleeding (2): Discharge internal capacitors/remaining charge

            changing mode can only be done when the power converter is not "Enable"</Notes>
        <Consumer>
          <NodeRef id="1" />
        </Consumer>
        <LabelSet>
          <Label name="DC_Controlled" value="0" />
          <Label name="AC_Controlled" value="1" />
          <Label name="Bleeding" value="2" />
        </LabelSet>
      </Signal>
    </Message>

    
    <Message id="0x850041" length="1" name="GN01_Mode_Applied" interval="1000" format="extended">
      <Notes>GN01 actual operating mode (readback)</Notes>
      <Producer> 
        <NodeRef id="1" /> 
      </Producer>
      <Signal name="mode" offset="0" length="8">
        <Notes>Currently applied operating mode

                changing mode can only be done when the power converter is not "Enable"
          </Notes>
        <Consumer> 
          <NodeRef id="0" /> 
        </Consumer>
        <LabelSet>
          <Label name="DC_Controlled" value="0" />
          <Label name="AC_Controlled" value="1" />
          <Label name="Bleeding" value="2" />
        </LabelSet>
      </Signal>
    </Message>


    <Message id="0x850042" length="8" name="GN01_faults" interval="1000" format="extended">
      <Notes>GN01 Critical and error conditions</Notes>
      <Producer>
