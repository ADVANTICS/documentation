      <Signal name="CABLE_1_2_L1" offset="0" length="1" endianess="little">
        <Notes>Critical: Phase mismatch between DMF1(1).L1 and BP25(2).U</Notes>
        <Consumer><NodeRef id="0" /></Consumer>
        <LabelSet><Label name="Clear" value="0" /><Label name="Critical" value="1" /></LabelSet>
      </Signal>

      <Signal name="CABLE_1_3_L1" offset="1" length="1" endianess="little">
