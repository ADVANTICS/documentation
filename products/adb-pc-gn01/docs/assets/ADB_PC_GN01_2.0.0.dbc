CM_ SG_ 8716324 Current "Current through the DC Port";
CM_ SG_ 8716324 Voltage "Voltage on the DC Port";
CM_ BO_ 8716322 "Setpoints for applying Droop on the DC Port. Droop is needed for paralleling multiple GN01";
CM_ SG_ 8716322 Reserved "This space is reserved. This region should contain only '0's";
CM_ SG_ 8716322 Enable "Enable DC Droop. If this feature is enabled the output voltage of the DC port varies with output current.";
CM_ SG_ 8716322 Negative_Current_Droop "The droop resistance to apply for current flowing in to the DC Port (DC current is negative)";
CM_ SG_ 8716322 Positive_Current_Droop "The droop resistance to apply for current flowing out of the DC port (DC current is positive)";
CM_ BO_ 8716323 "Droop setpoints that are applied by the GN01";
CM_ SG_ 8716323 Enable "Show is DC Droop is enabled.";
CM_ SG_ 8716323 Negative_Current_Droop "The droop resistance applied for current flowing in to the DC Port (DC current is negative)";
CM_ SG_ 8716323 Positive_Current_Droop "The droop resistance applied for current flowing out of the DC port (DC current is positive)";
CM_ BO_ 8716336 "Setpoints to apply to the AC Port";
CM_ SG_ 8716336 RMS_Phase_Current_Limit "The maximum RMS current that the GN01 will supply at its AC terminals.
                This value limits the the magnitute of the AC current and applies
                symmetrically to both source and sink currents. This limit applies to
                the current carried by a single phase.
        ";
CM_ SG_ 8716336 Q "Reactive Power of the AC port. Positive values cause the GN01 to behave inductively, negative values cause the GN01 to behave capacitively";
CM_ SG_ 8716336 grid_standard "Grid voltage and frequency standard";
CM_ SG_ 8716336 phase_config "
              FOLLOW_N        (0): follow phase + neutral
              SINGLE_PHASE_N  (1): 1-phase + neutral
              THREE_PHASE     (2): 3-phase, no neutral (delta load)
              THREE_PHASE_N   (3): 3-phase + neutral (star load)
        ";
CM_ BO_ 8716337 "Setpoints that are currently being applied to the the AC Port";
CM_ SG_ 8716337 RMS_Phase_Current_Limit "The maximum RMS current that the GN01 will supply at its AC terminals.
                This value limits the the magnitute of the AC current and applies
                symmetrically to both source and sink currents. This limit applies to
                the current carried by a single phase.
        ";
CM_ SG_ 8716337 Q "Reactive Power of the AC port. Positive values cause the GN01 to behave inductively, negative values cause the GN01 to behave capacitively";
CM_ SG_ 8716337 grid_standard "Grid voltage and frequency standard";
CM_ SG_ 8716337 phase_config "
              SINGLE_PHASE_N  (1): 1-phase + neutral
              THREE_PHASE     (2): 3-phase, no neutral (delta load)
              THREE_PHASE_N   (3): 3-phase + neutral (star load)
        ";
CM_ BO_ 8716338 "Setpoints for applying Droop on the DC Port. Droop is needed for paralleling multiple AC01";
CM_ SG_ 8716338 Reserved "This space is reserved. This region should contain only '0's";
CM_ SG_ 8716338 Enable_Integral_Action " Enable integral action for the Power loops. Enable this only if connected
                to the utility grid. If you go off-grid, this bit must be immediately cleared.
                This is disabled by default on startup.
        ";
CM_ SG_ 8716338 Disable_Harmonic_Compensation " Set this flag when harmonic compensation needs to be disabled (i.e, when 
                the ADB is connected in parallel to the grid or to other diesel generators).
                Harmonic compensation is enabled by default on startup. 
        ";
CM_ SG_ 8716338 Enable "Enable AC Droop. If this feature is enabled the output voltage of the AC port varies with output current.";
CM_ SG_ 8716338 Virtual_Impedance " Sets the inductive virtual impedance in microhenries (uH). By default
                    (i.e: after power cycle), this value is 8000 uH
          ";
CM_ SG_ 8716338 Volt_droop_nominal " Sets the nominal droop slope for the Voltage in V/MVAr. By default
                    (i.e: after power cycle), this value is 630 V/MVAr
          ";
CM_ SG_ 8716338 Freq_droop_nominal " Sets the nominal droop slope for the Frequency in Hz/MW. By default
                    (i.e: after power cycle), this value is 40 Hz/MW
        ";
CM_ BO_ 8716339 "Droop setpoints currently applied by the AC01.";
CM_ SG_ 8716339 Reserved "
          This space is reserved. This region should contain only '0's.
        ";
CM_ SG_ 8716339 Enable_Integral_Action "
          Indicates whether integral action for the power loops is enabled.
          This should only be enabled when connected to the utility grid.
        ";
CM_ SG_ 8716339 Disable_Harmonic_Compensation "
          Indicates whether harmonic compensation is disabled.
        ";
CM_ SG_ 8716339 Enable "
          Indicates whether AC droop is enabled.
        ";
CM_ SG_ 8716339 Virtual_Impedance "
          The applied inductive virtual impedance in microhenries (uH).
        ";
CM_ SG_ 8716339 Volt_droop_nominal "
          The applied nominal voltage droop slope in V/MVAr.
          The value represents the voltage variation per MVAr of reactive power.
        ";
CM_ SG_ 8716339 Freq_droop_nominal "
          The applied nominal frequency droop slope in Hz/MW.
          The value represents the frequency variation per megawatt of active power.
        ";
