CM_ SG_ 8716355 grid_selection_wrong "Warning: grid selection is wrong

              converter see an existing grid and the selected grid mode is different 
        ";
CM_ SG_ 8716355 grid_not_existing "Warning: The converter is not connected to existing grid ";
CM_ SG_ 8716355 grid_not_supported "Warning: Grid is not supported 

        
            3-Phase 230V (line-to-neutral) / 400V (line-to-line), 50Hz
            3-Phase 277V (line-to-neutral) / 480V (line-to-line), 60Hz
            3-Phase 120V (line-to-neutral) / 208V (line-to-line), 60Hz
        ";
CM_ BO_ 8716356 "Info: Informational status and operating conditions";
