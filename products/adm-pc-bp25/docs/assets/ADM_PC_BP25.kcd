            <Value type="signed" unit="-" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="4">
          <Signal name="Voltage_V" offset="0" length="16" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="signed" unit="-" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="5">
          <Signal name="Voltage_W" offset="0" length="16" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="signed" unit="-" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="6">
          <Signal name="Voltage_DC" offset="0" length="16" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="signed" unit="-" />
          </Signal>
        </MuxGroup>
      </Multiplex>
    </Message>

    <Message id="0x78052" length="6" name="_AFE_Calibration_Adc_Fs" interval='1000' format="extended">
      <Notes> Adc fullscale value of readouts. </Notes>
      <Producer> <NodeRef id="7"/> </Producer>
      <Multiplex name="Adc_Index" offset="32" length="16">
        <MuxGroup count="0">
          <Signal name="Current_U" offset="0" length="32" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="single" unit="Fullscale" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="1">
          <Signal name="Current_V" offset="0" length="32" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="single" unit="Fullscale" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="2">
          <Signal name="Current_W" offset="0" length="32" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="single" unit="Fullscale" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="3">
          <Signal name="Voltage_U" offset="0" length="32" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="single" unit="Fullscale" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="4">
          <Signal name="Voltage_V" offset="0" length="32" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="single" unit="Fullscale" />
          </Signal>
       </MuxGroup>
       <MuxGroup count="5">
          <Signal name="Voltage_W" offset="0" length="32" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="single" unit="Fullscale" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="6">
          <Signal name="Voltage_DC" offset="0" length="32" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="single" unit="Fullscale" />
          </Signal>
        </MuxGroup>
      </Multiplex>
    </Message>

    <Message id="0x78053" length="4" name="_AFE_Calibration_Adc_Offset" interval='1000' format="extended">
      <Notes> Readout of ADC calibration data (offset) from EEPROM. </Notes>
      <Producer> <NodeRef id="7"/> </Producer>
      <Multiplex name="Adc_Index" offset="16" length="16">
        <MuxGroup count="0">
          <Signal name="Current_U" offset="0" length="16" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="signed" unit="-" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="1">
          <Signal name="Current_V" offset="0" length="16" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="signed" unit="-" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="2">
          <Signal name="Current_W" offset="0" length="16" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="signed" unit="-" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="3">
          <Signal name="Voltage_U" offset="0" length="16" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="signed" unit="-" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="4">
          <Signal name="Voltage_V" offset="0" length="16" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="signed" unit="-" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="5">
          <Signal name="Voltage_W" offset="0" length="16" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="signed" unit="-" />
          </Signal>
        </MuxGroup>
        <MuxGroup count="6">
          <Signal name="Voltage_DC" offset="0" length="16" endianess="little">
            <Consumer> <NodeRef id="0"/> </Consumer>
            <Value type="signed" unit="-" />
          </Signal>
        </MuxGroup>
      </Multiplex>
    </Message>

    <Message id="0x78056" length="2" name="AFE_Interlock_Faults" interval="1000" format="extended">
      <Notes>Fault bitfield</Notes>
      <Producer> <NodeRef id="7"/> </Producer>
      <Signal name="Current_U_High" offset="0" length="1" endianess="little">
        <Notes>This flag is set if a hight current on U tripped the internal interlock</Notes>
        <Consumer> <NodeRef id="0"/> </Consumer>
        <LabelSet>
            <Label name="fault" value="1"/>
        </LabelSet>
      </Signal>
      <Signal name="Current_U_Low" offset="1" length="1" endianess="little">
        <Notes>This flag is set if a low current on U tripped the internal interlock</Notes>
        <Consumer> <NodeRef id="0"/> </Consumer>
        <LabelSet>
            <Label name="fault" value="1"/>
        </LabelSet>
      </Signal>
      <Signal name="Current_V_High" offset="2" length="1" endianess="little">
        <Notes>This flag is set if a hight current on V tripped the internal interlock</Notes>
        <Consumer> <NodeRef id="0"/> </Consumer>
        <LabelSet>
            <Label name="fault" value="1"/>
        </LabelSet>
      </Signal>
      <Signal name="Current_V_Low" offset="3" length="1" endianess="little">
        <Notes>This flag is set if a low current on V tripped the internal interlock</Notes>
        <Consumer> <NodeRef id="0"/> </Consumer>
        <LabelSet>
            <Label name="fault" value="1"/>
        </LabelSet>
      </Signal>
      <Signal name="Current_W_High" offset="4" length="1" endianess="little">
        <Notes>This flag is set if a hight current on W tripped the internal interlock</Notes>
        <Consumer> <NodeRef id="0"/> </Consumer>
        <LabelSet>
            <Label name="fault" value="1"/>
        </LabelSet>
      </Signal>
      <Signal name="Current_W_Low" offset="5" length="1" endianess="little">
        <Notes>This flag is set if a low current on W tripped the internal interlock</Notes>
        <Consumer> <NodeRef id="0"/> </Consumer>
        <LabelSet>
            <Label name="fault" value="1"/>
        </LabelSet>
      </Signal>
      <Signal name="Voltage_DC" offset="6" length="1" endianess="little">
        <Notes>This flag is set if a voltage on DC tripped the internal interlock</Notes>
        <Consumer> <NodeRef id="0"/> </Consumer>
        <LabelSet>
            <Label name="fault" value="1"/>
        </LabelSet>
      </Signal>
      <Signal name="Reboot" offset="7" length="1" endianess="little">
        <Notes>This flag is set if a reboot tripped the internal interlock</Notes>
        <Consumer> <NodeRef id="0"/> </Consumer>
        <LabelSet>
            <Label name="fault" value="1"/>
        </LabelSet>
      </Signal>
      <Signal name="Unknown" offset="8" length="1" endianess="little">
        <Notes>This flag the reason for the internal interlock is unknown</Notes>
        <Consumer> <NodeRef id="0"/> </Consumer>
        <LabelSet>
            <Label name="fault" value="1"/>
        </LabelSet>
      </Signal>
    </Message>

    <Message id="0x78151" length="8" name="AFE_Inverter_Droop_Readback" interval="100" format="extended">
      <Notes>
        Readback for droop control parameters set in the 0x70051
      </Notes>
      <Producer>
        <NodeRef id="7"/>
      </Producer>
      <Signal name="Freq_droop_nominal" offset="0" length="16" endianess="little">
        <Consumer>
          <NodeRef id="0"/>
        </Consumer>
        <Value type="signed" slope="0.01" unit="Hz/MW"/>
      </Signal>
      <Signal name="Volt_droop_nominal" offset="16" length="16" endianess="little">
        <Consumer>
          <NodeRef id="0"/>
        </Consumer>
        <Value type="signed" slope="0.1" unit="V/MVAr"/>
      </Signal>
      <Signal name="Virtual_Impedance" offset="32" length="16" endianess="little">
        <Consumer>
          <NodeRef id="0"/>
        </Consumer>
        <Value type="signed" slope="1" unit="uH"/>
      </Signal>
    </Message>

    <Message id="0x70052" length="6" name="AFE_Firmware_Dev" format="extended">
      <Notes>Used for firmware development</Notes>
      <Producer>
        <NodeRef id="0"/>
      </Producer>
      <Multiplex name="Data_Type" offset="32" length="4">
        <MuxGroup count="0">
          <Signal name="Flag" offset="0" length="1" endianess="little">
            <Consumer>
              <NodeRef id="7"/>
            </Consumer>
          </Signal>
        </MuxGroup>
        <MuxGroup count="1">
          <Signal name="U16" offset="0" length="16" endianess="little">
            <Consumer>
              <NodeRef id="7"/>
            </Consumer>
            <Value type="unsigned"/>
          </Signal>
        </MuxGroup>
        <MuxGroup count="2">
          <Signal name="I16" offset="0" length="16" endianess="little">
            <Consumer>
              <NodeRef id="7"/>
            </Consumer>
            <Value type="signed"/>
          </Signal>
        </MuxGroup>
        <MuxGroup count="3">
          <Signal name="U32" offset="0" length="32" endianess="little">
            <Consumer>
              <NodeRef id="7"/>
            </Consumer>
            <Value type="unsigned"/>
          </Signal>
        </MuxGroup>
        <MuxGroup count="4">
          <Signal name="I32" offset="0" length="32" endianess="little">
            <Consumer>
              <NodeRef id="7"/>
            </Consumer>
            <Value type="signed"/>
          </Signal>
        </MuxGroup>
        <MuxGroup count="5">
          <Signal name="F32" offset="0" length="32" endianess="little">
            <Consumer>
              <NodeRef id="7"/>
            </Consumer>
            <Value type="unsigned"/>
          </Signal>
        </MuxGroup>
      </Multiplex>
      <Signal name="Index" offset="36" length="12" endianess="little">
        <Consumer>
          <NodeRef id="7"/>
        </Consumer>
        <Value type="unsigned"/>
      </Signal>
    </Message>

    <Message id="0x70051" length="6" name="AFE_Inverter_Droop_Control" format="extended">
      <Notes> This message is used to define the droop characteristics of the module in Inverter 3-Phase operation. The droop curve for both voltage and frequency is 
              defined as a symetric 3 linear segments. The 'nominal' segment is defined solely
              by the slope (it intersects the zero). Then the other two segments, called
              'auxiliary' are symetric around the zero, and they are defined by an intersection 
              point and another slope. For more info, check the user manual.
      </Notes>
      <Producer> <NodeRef id="0"/> </Producer>
      <Multiplex name="Parameter_Index" offset="16" length="16">
        <MuxGroup count="0">
          <Signal name="Freq_droop_nominal" offset="0" length="16" endianess="little">
            <Notes> Sets the nominal droop slope for the Frequency in Hz/MW. By default
                    (i.e: after power cycle), this value is 40 Hz/MW </Notes>
            <Consumer> <NodeRef id="7"/> </Consumer>
            <Value type="signed" slope="0.01" unit="Hz/MW"/>
          </Signal>
        </MuxGroup>
        <MuxGroup count="1">
          <Signal name="Volt_droop_nominal" offset="0" length="16" endianess="little">
            <Notes> Sets the nominal droop slope for the Voltage in V/MVAr. By default
                    (i.e: after power cycle), this value is 630 V/MVAr</Notes>
            <Consumer> <NodeRef id="7"/> </Consumer>
            <Value type="signed" slope="0.1" unit="V/MVAr"/>
          </Signal>
        </MuxGroup>
        <MuxGroup count="2">
          <Signal name="Reserved" offset="0" length="16" endianess="little">
            <Consumer><NodeRef id="7"/></Consumer>
          </Signal>
        </MuxGroup>
        <MuxGroup count="6">
          <Signal name="Virtual_Impedance" offset="0" length="16" endianess="little">
            <Notes> Sets the inductive virtual impedance in microhenries (uH). By default
                    (i.e: after power cycle), this value is 8000 uH</Notes>
            <Consumer> <NodeRef id="7"/> </Consumer>
            <Value type="signed" slope="1" unit="uH"/>
          </Signal>
        </MuxGroup>
      </Multiplex>
      <Signal name="Disable_Harmonic_Compensation" offset="32" length="1" endianess="little">
        <Notes> Set this flag when harmonic compensation needs to be disabled (i.e, when 
                the module is connected in parallel to the grid or to other diesel generators).
                Harmonic compensation is enabled by default on startup. </Notes>
        <Consumer> <NodeRef id="7"/> </Consumer>
      </Signal>
      <Signal name="Enable_Integral_Action" offset="33" length="1" endianess="little">
        <Notes> Enable integral action for the Power loops. Enable this only if connected
                to the utility grid. If you go off-grid, this bit must be immediately cleared.
                This is disabled by default on startup.</Notes>
        <Consumer> <NodeRef id="7"/> </Consumer>
      </Signal>
      <Signal name="Enable_Legacy_Mode" offset="34" length="1" endianess="little">
        <Notes> If legacy mode is enabled, module will behave as previous to the
                introduction of the droop feature. It will generate the AC waveform in 
                open loop, and will not be able to be paralleled.
        </Notes>
        <Consumer> <NodeRef id="7"/> </Consumer>
      </Signal>
      <Signal name="Enable_Droop" offset="35" length="1" endianess="little">
        <Notes>Enables droop control extension for INVERTER_1PH_SYNC control mode.</Notes>
        <Consumer> <NodeRef id="7"/> </Consumer>
      </Signal>
    </Message>

    <Message id="0x7004E" length="6" name="AFE_DC_setpoint_control" format="extended">
      <Notes>Control of the setpoints in DC/DC modes (buck and boost)</Notes>
      <Producer> <NodeRef id="0"/> </Producer>
      <Signal name="Voltage_Setpoint" offset="0" length="16" endianess="little">
        <Notes>The voltage setpoint in DC/DC modes. This message is an alternate way of defining the 'normal' voltage setpoint, but only applies in DC/DC modes. In boost mode this value needs to be larger than the low side voltage at all times.</Notes>
        <Consumer> <NodeRef id="7"/> </Consumer>
        <Value slope="0.1" intercept="0" unit="V" type="unsigned" min="0" max="1500"/>
      </Signal>
      <Signal name="positive_current_limit" offset="16" length="16" endianess="little">
        <Notes>The current limit for current in forward direction (DC->Phases in Buck, Phases->DC in Boost), this limit applies to the phase side currents</Notes>
        <Consumer> <NodeRef id="7"/> </Consumer>
        <Value slope="0.01" intercept="0" unit="A" type="signed" min="0" max="150"/>
      </Signal>
      <Signal name="negative_current_limit" offset="32" length="16" endianess="little">
        <Notes>The current limit in reverse direction. (Phases->DC in Buck, DC->Phases in Boost) This limit applies to the phase side currents</Notes>
        <Consumer> <NodeRef id="7"/> </Consumer>
        <Value slope="0.01" intercept="0" unit="A" type="signed" min="-150" max="0"/>
      </Signal>
    </Message>

    <Message id="0x7004D" length="4" name="AFE_DC_droop_control" format="extended">
      <Notes>Set parameters for DC Droop control</Notes>
      <Producer> <NodeRef id="0"/> </Producer>
      <Multiplex name="Multiplex_Index" offset="8" length="8">
        <MuxGroup count="0">
            <Signal name="Reserved" offset="16" length="16" endianess="little">
              <Notes>Reserved for future use. Makes it possible to Enable or
              Disable DC droop without affecting resistance values</Notes>
              <Consumer><NodeRef id="7"/></Consumer>
              <Value slope="1" unit="-" type="unsigned"/>
            </Signal>
        </MuxGroup>
        <MuxGroup count="1">
            <Signal name="Droop_resistance_positive_current" offset="16" length="16" endianess="little">
              <Notes>Virtual droop resistance in Ohms when current is positive. Its default
              value after power cycling is 1 Ohm for VA08,VA01 and VA04 variants, and 3 Ohm for VA03
              variant.</Notes>
              <Consumer><NodeRef id="7"/></Consumer>
              <Value slope="0.001" unit="Ohm" type="unsigned"/>
            </Signal>
        </MuxGroup>
        <MuxGroup count="2">
            <Signal name="Droop_resistance_negative_current" offset="16" length="16" endianess="little">
                <Notes>Virtual droop resistance in Ohms when current is negative. Its default 
                value after power cycling is 1 Ohm for VA08,VA01 and VA04 variants, and 3 Ohm for VA03
                variant.</Notes>
                <Consumer><NodeRef id="7"/></Consumer>
                <Value slope="0.001" unit="Ohm" type="unsigned"/>
            </Signal>
        </MuxGroup>
        <MuxGroup count="3">
            <Signal name="Droop_voltage_offset" offset="16" length="16" endianess="little">
              <Notes>Direct voltage offset on the voltage reference.</Notes>
              <Consumer><NodeRef id="7"/></Consumer>
              <Value slope="0.001" unit="V" type="signed" min="-30" max="30"/>
            </Signal>
        </MuxGroup>
      </Multiplex>
      <Signal name="Enable" offset="0" length="1" endianess="little">
          <Notes>Flag to enable droop. If enabled, the voltage Setpoint
          will be modified according to the following equation:
          Vref' = Vref - I*Rdroop. Droop is disabled by default upon
          power cycle.</Notes>
          <Consumer><NodeRef id="7"/></Consumer>
      </Signal>
    </Message>

    <Message id="0x78050" length="8" name="AFE_Droop_setpoints" interval="1000" format="extended">
      <Notes> Reads the droop resistance values of user </Notes>
      <Producer> <NodeRef id="7"/> </Producer>
      <Signal name="Positive_droop" offset="0" length="16" endianess="little">
        <Consumer> <NodeRef id="0"/> </Consumer>
        <Value slope="0.001" unit="Ohm" type="unsigned"/>
      </Signal>
      <Signal name="Negative_droop" offset="16" length="16" endianess="little">
        <Consumer> <NodeRef id="0"/> </Consumer>
        <Value slope="0.001" unit="Ohm" type="unsigned"/>
      </Signal>
      <Signal name="droop_enable" offset="32" length="1" endianess="little">
        <Consumer> <NodeRef id="0"/> </Consumer>
      </Signal>
      <Signal name="droop_enable_2" offset="33" length="1" endianess="little">
        <Consumer> <NodeRef id="0"/> </Consumer>
      </Signal>
    </Message>

    <Message id="0x78069" length="6" name="AFE_DC_Setpoints" interval="1000" format="extended">
      <Notes>Setpoints</Notes>
      <Producer> <NodeRef id="7"/> </Producer>
      <Signal name="Voltage_Setpoint" offset="0" length="16">
        <Notes>The actual negative current setpoint</Notes>
        <Consumer> <NodeRef id="0"/> </Consumer>
        <Value type="unsigned" slope="0.1" unit="V"/>
      </Signal>
      <Producer> <NodeRef id="7"/> </Producer>
      <Signal name="positive_Current_setpoint" offset="16" length="16">
        <Notes>The actual negative current setpoint</Notes>
        <Consumer> <NodeRef id="0"/> </Consumer>
        <Value type="signed" slope="0.01" unit="A"/>
      </Signal>
      <Producer> <NodeRef id="7"/> </Producer>
      <Signal name="negative_Current_setpoint" offset="32" length="16">
        <Notes>The actual negative current setpoint</Notes>
        <Consumer> <NodeRef id="0"/> </Consumer>
        <Value type="signed" slope="0.01" unit="A"/>
      </Signal>
    </Message>
    
  </Bus>
</NetworkDefinition>
