      <Signal name="Positive_power_limit" offset="0" length="16" endianess="little">
        <Notes>Sets the positive power limit.</Notes>
        <Consumer><NodeRef id="0"/></Consumer>
        <Value type="signed" slope="10" unit="W"/>
      </Signal>
      <Signal name="Negative_power_limit" offset="16" length="16" endianess="little">
